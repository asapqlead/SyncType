# ===========================================
# SyncType Frontend - Environment Variables
# ===========================================

# -------------------------------------------
# API Configuration
# -------------------------------------------
# The base URL for the backend API (no trailing slash)

# Local Development (default if not set)
# VITE_API_BASE=http://127.0.0.1:8000/api

# Production — replace with your deployed backend URL
# Example (Render): VITE_API_BASE=https://synctype-api.onrender.com/api
# Example (Railway): VITE_API_BASE=https://synctype-api.up.railway.app/api
# Example (Fly.io): VITE_API_BASE=https://synctype-api.fly.dev/api
VITE_API_BASE=https://your-backend-url.onrender.com/api
